{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "task_id", "owner", "host", "scope", "target", "started_at", "updated_at", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project": {"type": ["string", "null"], "pattern": "^(P[0-9]{3}|PUB[0-9]{3}|INV[0-9]{3})$"},
    "work_item": {"type": ["string", "null"], "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "scope": {"enum": ["repository", "project", "vault"]},
    "target": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "last_checkpoint": {"type": ["string", "null"], "minLength": 1},
    "next_action": {"type": ["string", "null"], "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "autonomy": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "claimable": {"type": "boolean"},
    "status": {"enum": ["active", "paused", "completed", "cancelled", "blocked", "recovery_needed", "abandoned"]}
  }
}
