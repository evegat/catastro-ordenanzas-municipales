{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "from_agent",
    "to_agent",
    "base_revision",
    "changes",
    "files",
    "tests",
    "risks",
    "pending",
    "rollback",
    "integration_owner"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "from_agent": {
      "type": "string",
      "minLength": 1
    },
    "to_agent": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "integration_owner": {
      "type": "string",
      "minLength": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^P[0-9]{3}$"
    },
    "deliverable_path": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria_met": {
      "type": "boolean"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "persisted_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "mirror_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
